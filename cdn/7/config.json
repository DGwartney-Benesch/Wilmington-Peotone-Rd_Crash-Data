    "widget_114": {
      "uri": "widgets/common/text/",
      "version": "1.20.0",
      "label": "Text 3",
      "config": {
        "text": "<p><span style=\"font-size: 14px;\">The Wilmington-Peotone Road Phase I Study is evaluating potential improvements along approximately two miles of Wilmington-Peotone Road between US 45/52 and Center Road. For more information, click the information icon (i) on the top right of the page.</span></p><p><br></p><p><span style=\"font-size: 14px;\">This app may be used to leave a comment for our team's consideration. To leave a comment, verify if the sidebar on the left is open. If it is closed, press the triangle to expand it. Select the LAYERS toggle to switch to the layer list, and press the Add Comment button on the bottom. </span></p>",
        "style": {
          "verticalAlign": "start",
          "wrap": true
        }
