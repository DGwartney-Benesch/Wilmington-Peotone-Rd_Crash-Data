    "widget_95": {
      "uri": "widgets/common/text/",
      "version": "1.20.0",
      "icon": {
        "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 16 16\"><path fill=\"#000\" d=\"M8 5.5a1 1 0 1 0 0-2 1 1 0 0 0 0 2M6.5 7.5A.5.5 0 0 1 7 7h1.5v4.5h1a.5.5 0 0 1 0 1h-3a.5.5 0 0 1 0-1h1V8H7a.5.5 0 0 1-.5-.5\"></path><path fill=\"#000\" fill-rule=\"evenodd\" d=\"M8 16A8 8 0 1 1 8 0a8 8 0 0 1 0 16m0-1A7 7 0 1 0 8 1a7 7 0 0 0 0 14\" clip-rule=\"evenodd\"></path></svg>",
        "properties": {
          "filename": "Info",
          "originalName": "outlined/suggested/info.svg",
          "path": [
            "generalAndArrows",
            "info"
          ],
          "inlineSvg": true,
          "isUploaded": false,
          "color": ""
        }
      },
      "label": "About",
      "config": {
        "text": "<p><br></p><p><br></p><p><strong style=\"font-size: 20px;\">Project Information</strong></p><p><br></p><p><br></p><p><span style=\"font-size: 14px;\">The Wilmington-Peotone Road Phase I Study is evaluating potential improvements along approximately two miles of Wilmington-Peotone Road between US 45/52 and Center Road. The study will examine existing roadway conditions, traffic operations, safety, drainage, environmental resources, and future transportation needs to identify improvements that enhance safety, mobility, and overall travel through the corridor. The study will also evaluate options for roadway cross sections, intersection improvements, and accommodations for all roadway users. </span></p><p><br></p><p><span style=\"font-size: 14px;\">As part of the planning process, the project team is gathering information from residents, property owners, businesses, and others who use the corridor. Local knowledge helps identify issues that may not be apparent through engineering analysis alone, including safety concerns, drainage issues, access needs, traffic operations, and locations that present challenges for pedestrians, bicyclists, or motorists. This feedback will help ensure the proposed improvements reflect both technical analysis and community priorities. </span></p><p><br></p><p><span style=\"font-size: 14px;\">Use this map to share comments tied to a specific location along the project corridor. You may identify areas of concern, suggest opportunities for improvement, or provide other observations about how the roadway is used today. Each comment will become part of the public involvement process and will be reviewed alongside engineering, environmental, and traffic studies as the project team develops and evaluates potential improvement alternatives. </span></p>",
        "style": {
          "wrap": true
        }
      },
      "id": "widget_95"
    },
